#!/usr/bin/env bash
set -euo pipefail

SELF="${BASH_SOURCE[0]}"
ROOT="$(cd "$(dirname "$SELF")/.." && pwd)"
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/tmux-tea"
CONFIG_FILE="$CONFIG_DIR/teas.tsv"
STATE_FILE="${TMPDIR:-/tmp}/tmux-tea-state.${UID:-$(id -u)}"
ACK_FILE="$STATE_FILE.confirm"

die() {
	printf 'tmux-tea: %s\n' "$*" >&2
	exit 1
}

has_tmux() {
	command -v tmux >/dev/null 2>&1 && { [[ -n "${TMUX:-}" ]] || tmux display-message -p '#S' >/dev/null 2>&1; }
}

tmux_msg() {
	has_tmux && tmux display-message "$*" >/dev/null 2>&1 || true
}

shell_command() {
	local out="" part arg
	for arg in "$@"; do
		printf -v part '%q' "$arg"
		out+=" $part"
	done
	printf '%s' "${out# }"
}

ensure_config() {
	mkdir -p "$CONFIG_DIR"
	[[ -s "$CONFIG_FILE" ]] && return 0

	cat >"$CONFIG_FILE" <<'TSV'
shen-puer	Shen Puer	default	Classic	10,15,20,25,30,40
shu-puer	Shu Puer	default	Dense	8,12,16,20,25,30
da-hong-pao	Da Hong Pao	default	Rock	7,10,13,16,20
TSV
}

clean_field() {
	local value="$1"
	value="${value//$'\t'/ }"
	value="${value//$'\n'/ }"
	value="${value//$'\r'/ }"
	printf '%s' "$value"
}

slugify() {
	local value="$1" slug
	slug="$(printf '%s' "$value" | tr '[:upper:]' '[:lower:]' | sed -E 's/[^a-z0-9]+/-/g; s/^-+//; s/-+$//')"
	[[ -n "$slug" ]] || slug="item-$(date +%s)"
	printf '%s' "$slug"
}

normalize_pours() {
	local raw="$1" part out=""
	raw="${raw//;/,}"
	raw="${raw// /,}"
	raw="${raw//$'\t'/,}"

	IFS=',' read -r -a parts <<<"$raw"
	for part in "${parts[@]}"; do
		[[ -n "$part" ]] || continue
		[[ "$part" =~ ^[0-9]+$ ]] || die "pour '$part' is not a positive integer"
		(( part > 0 )) || die "pour '$part' must be greater than zero"
		out+="${out:+,}$part"
	done

	[[ -n "$out" ]] || die "at least one pour duration is required"
	printf '%s' "$out"
}

tea_exists() {
	local want="$1" tea_id tea_name schedule_id schedule_name pours
	ensure_config
	while IFS=$'\t' read -r tea_id tea_name schedule_id schedule_name pours || [[ -n "${tea_id:-}" ]]; do
		[[ "$tea_id" == "$want" ]] && return 0
	done <"$CONFIG_FILE"
	return 1
}

schedule_exists() {
	local want_tea="$1" want_schedule="$2" tea_id tea_name schedule_id schedule_name pours
	ensure_config
	while IFS=$'\t' read -r tea_id tea_name schedule_id schedule_name pours || [[ -n "${tea_id:-}" ]]; do
		[[ "$tea_id" == "$want_tea" && "$schedule_id" == "$want_schedule" ]] && return 0
	done <"$CONFIG_FILE"
	return 1
}

unique_tea_id() {
	local base="$1" id i=2
	id="$base"
	while tea_exists "$id"; do
		id="$base-$i"
		((i++))
	done
	printf '%s' "$id"
}

unique_schedule_id() {
	local tea_id="$1" base="$2" id i=2
	id="$base"
	while schedule_exists "$tea_id" "$id"; do
		id="$base-$i"
		((i++))
	done
	printf '%s' "$id"
}

find_schedule() {
	local want_tea="$1" want_schedule="$2"
	local tea_id tea_name schedule_id schedule_name pours
	ensure_config

	while IFS=$'\t' read -r tea_id tea_name schedule_id schedule_name pours || [[ -n "${tea_id:-}" ]]; do
		if [[ "$tea_id" == "$want_tea" && "$schedule_id" == "$want_schedule" ]]; then
			FOUND_TEA_ID="$tea_id"
			FOUND_TEA_NAME="$tea_name"
			FOUND_SCHEDULE_ID="$schedule_id"
			FOUND_SCHEDULE_NAME="$schedule_name"
			FOUND_POURS="$pours"
			return 0
		fi
	done <"$CONFIG_FILE"

	return 1
}

state_write() {
	local pid="$1" tea_id="$2" tea_name="$3" schedule_id="$4" schedule_name="$5"
	local pour_index="$6" total_pours="$7" remaining_sec="$8" status="$9"
	local tmp="$STATE_FILE.tmp.$$"

	{
		printf 'pid=%q\n' "$pid"
		printf 'tea_id=%q\n' "$tea_id"
		printf 'tea_name=%q\n' "$tea_name"
		printf 'schedule_id=%q\n' "$schedule_id"
		printf 'schedule_name=%q\n' "$schedule_name"
		printf 'pour_index=%q\n' "$pour_index"
		printf 'total_pours=%q\n' "$total_pours"
		printf 'remaining_sec=%q\n' "$remaining_sec"
		printf 'status=%q\n' "$status"
	} >"$tmp"
	mv "$tmp" "$STATE_FILE"
}

state_load() {
	[[ -r "$STATE_FILE" ]] || return 1

	pid=""
	tea_id=""
	tea_name=""
	schedule_id=""
	schedule_name=""
	pour_index=""
	total_pours=""
	remaining_sec=""
	status=""

	# State is generated by state_write with shell-escaped scalar assignments.
	# shellcheck disable=SC1090
	source "$STATE_FILE"
	[[ -n "${pid:-}" ]]
}

state_pid_alive() {
	state_load || return 1
	[[ "$pid" =~ ^[0-9]+$ ]] || return 1
	kill -0 "$pid" >/dev/null 2>&1
}

format_seconds() {
	local total="$1"
	printf '%d:%02d' "$((total / 60))" "$((total % 60))"
}

status_cmd() {
	if ! state_pid_alive; then
		rm -f "$STATE_FILE" "$ACK_FILE"
		return 0
	fi

	case "$status" in
		counting)
			printf 'tea %s %s/%s %s' "$tea_name" "$pour_index" "$total_pours" "$(format_seconds "$remaining_sec")"
			;;
		ready)
			printf 'tea %s %s/%s READY' "$tea_name" "$pour_index" "$total_pours"
			;;
		done)
			printf 'tea %s DONE' "$tea_name"
			;;
	esac
}

notify_cmd() {
	local title="${1:-TEA TIME}" line1="${2:-Pour is ready}" line2="${3:-Press Enter to close}"

	clear 2>/dev/null || true
	printf '\033[38;5;180m'
	cat <<'ART'
  _______ ______          _______ _____ __  __ ______
 |__   __|  ____|   /\   |__   __|_   _|  \/  |  ____|
    | |  | |__     /  \     | |    | | | \  / | |__
    | |  |  __|   / /\ \    | |    | | | |\/| |  __|
    | |  | |____ / ____ \   | |   _| |_| |  | | |____
    |_|  |______/_/    \_\  |_|  |_____|_|  |_|______|
ART
	printf '\033[0m\n'
	printf '  %s\n\n' "$title"
	printf '  %s\n' "$line1"
	printf '  %s\n\n' "$line2"
	printf '  Enter: close popup'
	read -r _ || true
}

show_ready_notification() {
	local line1="$1" line2="$2"
	tmux_msg "TEA TIME: $line1"
	[[ "${TMUX_TEA_NO_POPUP:-}" == "1" ]] && return 0
	has_tmux || return 0

	local command
	command="$(shell_command "$ROOT/scripts/tmux-tea" notify "TEA TIME" "$line1" "$line2")"
	tmux run-shell -b "tmux display-popup -E -w 64 -h 15 \"$command\"" >/dev/null 2>&1 || true
	tmux display-message -p '\007' >/dev/null 2>&1 || true
}

stop_cmd() {
	if state_load; then
		if [[ "${pid:-}" =~ ^[0-9]+$ && "$pid" != "$$" ]]; then
			kill "$pid" >/dev/null 2>&1 || true
		fi
	fi

	rm -f "$STATE_FILE" "$ACK_FILE"
	tmux_msg "tmux-tea stopped"
}

timer_cmd() {
	local tea_id_arg="$1" schedule_id_arg="$2" seconds remaining idx total

	find_schedule "$tea_id_arg" "$schedule_id_arg" || die "schedule not found: $tea_id_arg/$schedule_id_arg"
	IFS=',' read -r -a pours <<<"$FOUND_POURS"
	total="${#pours[@]}"
	(( total > 0 )) || die "schedule has no pours"

	for idx in "${!pours[@]}"; do
		seconds="${pours[$idx]}"
		[[ "$seconds" =~ ^[0-9]+$ ]] || continue
		for ((remaining = seconds; remaining > 0; remaining--)); do
			[[ -e "$STATE_FILE" || "$idx" == "0" ]] || exit 0
			state_write "$$" "$FOUND_TEA_ID" "$FOUND_TEA_NAME" "$FOUND_SCHEDULE_ID" "$FOUND_SCHEDULE_NAME" "$((idx + 1))" "$total" "$remaining" counting
			sleep 1
		done

		state_write "$$" "$FOUND_TEA_ID" "$FOUND_TEA_NAME" "$FOUND_SCHEDULE_ID" "$FOUND_SCHEDULE_NAME" "$((idx + 1))" "$total" 0 ready
		show_ready_notification "$FOUND_TEA_NAME - pour $((idx + 1))/$total" "Press prefix+t after draining"

		while [[ -e "$STATE_FILE" && ! -e "$ACK_FILE" ]]; do
			sleep 0.2
		done
		[[ -e "$STATE_FILE" ]] || exit 0
		rm -f "$ACK_FILE"
	done

	state_write "$$" "$FOUND_TEA_ID" "$FOUND_TEA_NAME" "$FOUND_SCHEDULE_ID" "$FOUND_SCHEDULE_NAME" "$total" "$total" 0 done
	show_ready_notification "$FOUND_TEA_NAME is done" "Session complete"
	rm -f "$STATE_FILE" "$ACK_FILE"
}

start_cmd() {
	local tea_id_arg="${1:-}" schedule_id_arg="${2:-}" child
	[[ -n "$tea_id_arg" && -n "$schedule_id_arg" ]] || die "usage: tmux-tea start <tea_id> <schedule_id>"
	find_schedule "$tea_id_arg" "$schedule_id_arg" || die "schedule not found: $tea_id_arg/$schedule_id_arg"

	stop_cmd >/dev/null 2>&1 || true
	nohup "$ROOT/scripts/tmux-tea" timer "$tea_id_arg" "$schedule_id_arg" >/dev/null 2>&1 &
	child="$!"
	tmux_msg "tmux-tea started: $FOUND_TEA_NAME / $FOUND_SCHEDULE_NAME"
	printf 'started %s/%s pid=%s\n' "$tea_id_arg" "$schedule_id_arg" "$child"
}

confirm_cmd() {
	if ! state_pid_alive; then
		rm -f "$STATE_FILE" "$ACK_FILE"
		tmux_msg "tmux-tea: no active timer"
		return 0
	fi

	case "$status" in
		ready)
			: >"$ACK_FILE"
			tmux_msg "tmux-tea: confirmed pour $pour_index/$total_pours"
			;;
		counting)
			tmux_msg "tmux-tea: $(format_seconds "$remaining_sec") until next pour"
			;;
		done)
			rm -f "$STATE_FILE" "$ACK_FILE"
			;;
	esac
}

menu_cmd() {
	ensure_config
	has_tmux || die "menu requires tmux"

	local -a args
	local tea_id tea_name schedule_id schedule_name pours key command
	local keys="123456789abcdefghijklmnopqrstuvwxyz"
	local count=0
	declare -A seen=()

	args=(-T "tmux-tea - choose tea")
	while IFS=$'\t' read -r tea_id tea_name schedule_id schedule_name pours || [[ -n "${tea_id:-}" ]]; do
		[[ -n "${seen[$tea_id]:-}" ]] && continue
		seen[$tea_id]=1
		key="${keys:$count:1}"
		[[ -n "$key" ]] || key=""
		command="run-shell -b \"$(shell_command "$ROOT/scripts/tmux-tea" schedule "$tea_id")\""
		args+=("$tea_name" "$key" "$command")
		count=$((count + 1))
	done <"$CONFIG_FILE"

	args+=("Edit teas and schedules" e "display-popup -E -w 72 -h 24 \"$(shell_command "$ROOT/scripts/tmux-tea" edit)\"")
	args+=("Stop active timer" x "run-shell -b \"$(shell_command "$ROOT/scripts/tmux-tea" stop)\"")
	tmux display-menu "${args[@]}"
}

schedule_menu_cmd() {
	local want_tea="${1:-}" tea_id tea_name schedule_id schedule_name pours key label command
	local keys="123456789abcdefghijklmnopqrstuvwxyz"
	local count=0
	local title="tmux-tea - schedules"
	local -a args

	[[ -n "$want_tea" ]] || die "usage: tmux-tea schedule <tea_id>"
	ensure_config
	has_tmux || die "schedule menu requires tmux"

	args=(-T "$title")
	while IFS=$'\t' read -r tea_id tea_name schedule_id schedule_name pours || [[ -n "${tea_id:-}" ]]; do
		[[ "$tea_id" == "$want_tea" ]] || continue
		key="${keys:$count:1}"
		label="$schedule_name ($pours)"
		command="run-shell -b \"$(shell_command "$ROOT/scripts/tmux-tea" start "$tea_id" "$schedule_id")\""
		args+=("$label" "$key" "$command")
		count=$((count + 1))
	done <"$CONFIG_FILE"

	(( count > 0 )) || die "tea not found: $want_tea"
	args+=("Add schedule" a "display-popup -E -w 72 -h 24 \"$(shell_command "$ROOT/scripts/tmux-tea" add-schedule "$want_tea")\"")
	args+=("Delete schedule" d "display-popup -E -w 72 -h 24 \"$(shell_command "$ROOT/scripts/tmux-tea" delete-schedule "$want_tea")\"")
	tmux display-menu "${args[@]}"
}

append_row() {
	local tea_id="$1" tea_name="$2" schedule_id="$3" schedule_name="$4" pours="$5"
	ensure_config
	printf '%s\t%s\t%s\t%s\t%s\n' \
		"$(clean_field "$tea_id")" \
		"$(clean_field "$tea_name")" \
		"$(clean_field "$schedule_id")" \
		"$(clean_field "$schedule_name")" \
		"$(clean_field "$pours")" >>"$CONFIG_FILE"
}

prompt_value() {
	local prompt="$1" default="${2:-}" value
	if [[ -n "$default" ]]; then
		read -r -p "$prompt [$default]: " value || true
		printf '%s' "${value:-$default}"
	else
		read -r -p "$prompt: " value || true
		printf '%s' "$value"
	fi
}

add_tea_cmd() {
	local name="${1:-}" schedule_name="${2:-}" pours="${3:-}" tea_id schedule_id
	ensure_config

	[[ -n "$name" ]] || name="$(prompt_value "Tea name")"
	[[ -n "$name" ]] || die "tea name is required"
	[[ -n "$schedule_name" ]] || schedule_name="$(prompt_value "Default schedule name" "Classic")"
	[[ -n "$pours" ]] || pours="$(prompt_value "Pour seconds, comma-separated" "10,15,20,25,30")"

	tea_id="$(unique_tea_id "$(slugify "$name")")"
	schedule_id="$(unique_schedule_id "$tea_id" "$(slugify "$schedule_name")")"
	pours="$(normalize_pours "$pours")"
	append_row "$tea_id" "$name" "$schedule_id" "$schedule_name" "$pours"
	printf 'added tea %s (%s)\n' "$name" "$tea_id"
}

add_schedule_cmd() {
	local tea_id="${1:-}" schedule_name="${2:-}" pours="${3:-}" tea_name="" schedule_id
	local row_tea_id row_tea_name row_schedule_id row_schedule_name row_pours
	ensure_config

	[[ -n "$tea_id" ]] || tea_id="$(prompt_value "Tea id")"
	while IFS=$'\t' read -r row_tea_id row_tea_name row_schedule_id row_schedule_name row_pours || [[ -n "${row_tea_id:-}" ]]; do
		if [[ "$row_tea_id" == "$tea_id" ]]; then
			tea_name="$row_tea_name"
			break
		fi
	done <"$CONFIG_FILE"

	[[ -n "$tea_name" ]] || die "tea not found: $tea_id"
	[[ -n "$schedule_name" ]] || schedule_name="$(prompt_value "Schedule name" "Classic")"
	[[ -n "$pours" ]] || pours="$(prompt_value "Pour seconds, comma-separated" "10,15,20,25,30")"

	schedule_id="$(unique_schedule_id "$tea_id" "$(slugify "$schedule_name")")"
	pours="$(normalize_pours "$pours")"
	append_row "$tea_id" "$tea_name" "$schedule_id" "$schedule_name" "$pours"
	printf 'added schedule %s/%s\n' "$tea_id" "$schedule_id"
}

delete_tea_cmd() {
	local want_tea="${1:-}" confirm tmp removed=0
	ensure_config
	[[ -n "$want_tea" ]] || want_tea="$(prompt_value "Tea id to delete")"
	[[ -n "$want_tea" ]] || die "tea id is required"
	confirm="$(prompt_value "Type DELETE to remove $want_tea")"
	[[ "$confirm" == "DELETE" ]] || die "delete cancelled"

	tmp="$CONFIG_FILE.tmp.$$"
	: >"$tmp"
	while IFS=$'\t' read -r tea_id tea_name schedule_id schedule_name pours || [[ -n "${tea_id:-}" ]]; do
		if [[ "$tea_id" == "$want_tea" ]]; then
			removed=1
			continue
		fi
		printf '%s\t%s\t%s\t%s\t%s\n' "$tea_id" "$tea_name" "$schedule_id" "$schedule_name" "$pours" >>"$tmp"
	done <"$CONFIG_FILE"
	mv "$tmp" "$CONFIG_FILE"
	(( removed == 1 )) || die "tea not found: $want_tea"
	printf 'deleted tea %s\n' "$want_tea"
}

delete_schedule_cmd() {
	local want_tea="${1:-}" want_schedule="${2:-}" confirm tmp removed=0
	ensure_config
	[[ -n "$want_tea" ]] || want_tea="$(prompt_value "Tea id")"
	[[ -n "$want_schedule" ]] || want_schedule="$(prompt_value "Schedule id to delete")"
	[[ -n "$want_tea" && -n "$want_schedule" ]] || die "tea id and schedule id are required"
	confirm="$(prompt_value "Type DELETE to remove $want_tea/$want_schedule")"
	[[ "$confirm" == "DELETE" ]] || die "delete cancelled"

	tmp="$CONFIG_FILE.tmp.$$"
	: >"$tmp"
	while IFS=$'\t' read -r tea_id tea_name schedule_id schedule_name pours || [[ -n "${tea_id:-}" ]]; do
		if [[ "$tea_id" == "$want_tea" && "$schedule_id" == "$want_schedule" ]]; then
			removed=1
			continue
		fi
		printf '%s\t%s\t%s\t%s\t%s\n' "$tea_id" "$tea_name" "$schedule_id" "$schedule_name" "$pours" >>"$tmp"
	done <"$CONFIG_FILE"
	mv "$tmp" "$CONFIG_FILE"
	(( removed == 1 )) || die "schedule not found: $want_tea/$want_schedule"
	printf 'deleted schedule %s/%s\n' "$want_tea" "$want_schedule"
}

list_config() {
	local tea_id tea_name schedule_id schedule_name pours last_tea=""
	ensure_config
	while IFS=$'\t' read -r tea_id tea_name schedule_id schedule_name pours || [[ -n "${tea_id:-}" ]]; do
		if [[ "$tea_id" != "$last_tea" ]]; then
			printf '\n%s  [%s]\n' "$tea_name" "$tea_id"
			last_tea="$tea_id"
		fi
		printf '  - %s [%s]: %s\n' "$schedule_name" "$schedule_id" "$pours"
	done <"$CONFIG_FILE"
}

edit_cmd() {
	local choice
	while true; do
		clear 2>/dev/null || true
		printf 'tmux-tea editor\n'
		printf '===============\n'
		list_config
		printf '\n'
		printf '1 add tea\n'
		printf '2 add schedule\n'
		printf '3 delete tea\n'
		printf '4 delete schedule\n'
		printf 'q quit\n\n'
		read -r -p '> ' choice || return 0
		case "$choice" in
			1) add_tea_cmd; prompt_value "Press Enter" >/dev/null ;;
			2) add_schedule_cmd; prompt_value "Press Enter" >/dev/null ;;
			3) delete_tea_cmd; prompt_value "Press Enter" >/dev/null ;;
			4) delete_schedule_cmd; prompt_value "Press Enter" >/dev/null ;;
			q|Q) return 0 ;;
		esac
	done
}

usage() {
	cat <<'USAGE'
tmux-tea commands:
  menu
  schedule <tea_id>
  start <tea_id> <schedule_id>
  confirm
  stop
  status
  edit
  add-tea [name] [schedule_name] [pours_csv]
  add-schedule <tea_id> [schedule_name] [pours_csv]
  delete-tea [tea_id]
  delete-schedule [tea_id] [schedule_id]
USAGE
}

main() {
	local command="${1:-menu}"
	shift || true

	case "$command" in
		menu) menu_cmd "$@" ;;
		schedule) schedule_menu_cmd "$@" ;;
		start) start_cmd "$@" ;;
		timer) timer_cmd "$@" ;;
		confirm) confirm_cmd "$@" ;;
		stop) stop_cmd "$@" ;;
		status) status_cmd "$@" ;;
		notify) notify_cmd "$@" ;;
		edit) edit_cmd "$@" ;;
		add-tea) add_tea_cmd "$@" ;;
		add-schedule) add_schedule_cmd "$@" ;;
		delete-tea) delete_tea_cmd "$@" ;;
		delete-schedule) delete_schedule_cmd "$@" ;;
		help|-h|--help) usage ;;
		*) usage >&2; exit 2 ;;
	esac
}

main "$@"
